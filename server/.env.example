# --- Storage backend: "local" (SQLite + local disk) or "supabase"
# (Postgres+pgvector + Supabase Storage) ---
STORAGE_MODE=local

# --- Logging (src/core/logging_config.py) ---
# Level for the "evidence_rag" logger tree (pipeline/llm/telemetry/api).
# Third-party library loggers stay at root's WARNING default regardless.
LOG_LEVEL=INFO

# --- Gemini - DORMANT unless ENABLE_ENTITY_GRAPH=true below. Every call
# this app makes in normal use (query rewriting, reranking, faithfulness
# judging, title generation, the final RAG answer) runs on Cloudflare now
# (see below) - Gemini's free-tier quota kept exhausting every candidate
# in its fallback chain during real use. Only src/graph.py's entity-graph
# extraction and scripts/test_connection.py still call Gemini, and entity
# graph defaults to disabled. GEMINI_API_KEY just needs to be ANY non-
# empty string if you leave entity graph off - it's required at startup
# (the google-genai client validates non-emptiness, not validity, at
# construction) but never actually called against Google's servers
# unless you turn entity graph on, so a placeholder value is fine. ---
GEMINI_API_KEY=unused-placeholder
GEMINI_CHAT_MODEL=gemini-2.5-flash
# Tried once if the primary chat model's call fails/rate-limits
# (src/core/llm.py) - a different model is often on a separate quota
# bucket. Ignored if GEMINI_CHAT_MODEL_CHAIN below is set.
GEMINI_FALLBACK_CHAT_MODEL=gemini-2.5-flash-lite
# Optional longer fallback chain, comma-separated, tried in order -
# overrides the two settings above when set. Run
# `python scripts/list_available_models.py` to see which model ids this
# key can actually call right now before filling this in.
# GEMINI_CHAT_MODEL_CHAIN=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash,gemini-2.0-flash-lite

# --- Cloudflare Workers AI - the active chat-generation provider for this
# app: the final RAG answer, query rewriting/decomposition, reranking,
# faithfulness judging, and conversation titling all run here now (see
# src/core/llm.py's Cloudflare section docstring). Free tier: 300 RPM,
# 10,000 Neurons/day, no payment method required - operations just fail
# once the daily allowance is used, no overage billing. Get an Account ID
# from the Cloudflare dashboard URL (dash.cloudflare.com/<ACCOUNT_ID>) and
# an API token with "Workers AI" read/edit permission from My Profile ->
# API Tokens. ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Verified against developers.cloudflare.com/workers-ai/models/.
CLOUDFLARE_MODEL=@cf/google/gemma-4-26b-a4b-it

# --- Voyage AI (embeddings) ---
# Get a key at https://dashboard.voyageai.com/api-keys
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3.5
# Output vector width - must match the pgvector column width and HNSW
# index set up by scripts/supabase_schema.sql exactly. Changing this
# requires re-running that migration and a full reingest of every
# document (see src/core/config.py's comment).
VOYAGE_EMBEDDING_DIMENSION=1024

# --- Entity graph (opt-in, Gemini-backed, adds one LLM call per
# document section during ingestion - see src/graph.py). Off by default:
# this was exhausting Gemini's free-tier quota and slowing ingestion to
# a crawl. Leave false unless you specifically want the /graph
# visualization feature. ---
ENABLE_ENTITY_GRAPH=false

# --- Retrieval-confidence abstention (advanced_mode only) ---
# Minimum rerank_score (0.0-1.0 Gemini-scored relevance, see
# src/retrieval/reranker.py) the best retrieved chunk must clear for the
# pipeline to attempt an answer at all; below this, it reports
# insufficient evidence instead of generating a weakly-grounded answer.
RETRIEVAL_CONFIDENCE_THRESHOLD=0.5

# --- Faithfulness hard gate (both modes) ---
# Below this LLM-as-judge score (0-1, fraction of the answer's claims
# actually supported by its retrieved chunks), the generated answer is
# withheld and replaced with an explicit faithfulness-check-failed message.
FAITHFULNESS_GATE_THRESHOLD=0.7

# --- Semantic response cache (src/response_cache.py) ---
# Only used for a conversation's first turn, and only to cache a fully-
# successful (non-gated, non-failed) result. In-memory/per-process.
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_SIMILARITY_THRESHOLD=0.97
RESPONSE_CACHE_TTL_SECONDS=3600
RESPONSE_CACHE_MAX_ENTRIES_PER_SCOPE=200

# --- Per-user rate limiting (src/rate_limiter.py) ---
# Guards the two routes that spend Gemini quota per call. In-memory/
# per-process, not shared across workers.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_CHAT_MAX_REQUESTS=20
RATE_LIMIT_UPLOAD_MAX_REQUESTS=5

# --- Supabase (only used when STORAGE_MODE=supabase) ---
# Direct Postgres connection string: Project Settings -> Database -> Connection string
# If your network has no IPv6 route, use the Connection Pooling string instead
# (Project Settings -> Database -> Connection Pooling, port 6543) - the direct
# db.<ref>.supabase.co host is IPv6-only on many projects now.
SUPABASE_DB_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
# Project API URL + service key (Project Settings -> API) - used only for Storage
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_STORAGE_BUCKET=documents
# Auth (Supabase Auth) verifies JWTs against SUPABASE_URL's public JWKS
# endpoint above - no separate secret needed.

# --- CORS: comma-separated origins allowed to call this API from a browser ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
