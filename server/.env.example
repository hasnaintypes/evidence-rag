# --- Storage backend: "local" (SQLite + local disk) or "supabase"
# (Postgres+pgvector + Supabase Storage) ---
STORAGE_MODE=local

# --- Gemini (chat generation + embeddings) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Entity graph (opt-in: one LLM call per document section) ---
ENABLE_ENTITY_GRAPH=false

# --- Retrieval-confidence abstention (advanced_mode only) ---
# Minimum cross-encoder rerank_score the best retrieved chunk must clear
# for the pipeline to attempt an answer at all; below this, it reports
# insufficient evidence instead of generating a weakly-grounded answer.
RETRIEVAL_CONFIDENCE_THRESHOLD=0.0

# --- Supabase (only used when STORAGE_MODE=supabase) ---
# Direct Postgres connection string: Project Settings -> Database -> Connection string
# If your network has no IPv6 route, use the Connection Pooling string instead
# (Project Settings -> Database -> Connection Pooling, port 6543) - the direct
# db.<ref>.supabase.co host is IPv6-only on many projects now.
SUPABASE_DB_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
# Project API URL + service key (Project Settings -> API) - used only for Storage
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_STORAGE_BUCKET=documents
# Auth (Supabase Auth) verifies JWTs against SUPABASE_URL's public JWKS
# endpoint above - no separate secret needed.

# --- CORS: comma-separated origins allowed to call this API from a browser ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
